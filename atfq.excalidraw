    {
      "id": "s_JgtQdbP6ptv-wi4P7oQ",
      "type": "text",
      "x": -636.3465047087298,
      "y": 291.3759629734536,
      "width": 772.4000244140625,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
