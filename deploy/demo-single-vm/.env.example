# Public endpoint
DEMO_DOMAIN=demo.atfq.org
ACME_EMAIL=admin@atfq.org
APP_PUBLIC_URL=https://demo.atfq.org
S3_PUBLIC_URL=https://demo.atfq.org/profiles

# Database
POSTGRES_USER=atfq
POSTGRES_PASSWORD=change-me-postgres-password
AUTH_DB=auth
USER_DB=user
WIKI_DB=wiki

# Service secrets
JWT_SECRET=change-me-long-random-jwt-secret
# Must be 32 bytes for ChaCha20Poly1305 usage in auth.
CHA_CHA_KEY=0123456789abcdef0123456789abcdef

# MinIO / S3-compatible local object storage
MINIO_ROOT_USER=atfq
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_BUCKET=profiles

# OAuth is optional for the demo. Leave blank to disable providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://demo.atfq.org/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://demo.atfq.org/auth/callback/github

# Demo email capture. Keep Mailpit for the recruiter demo unless real SMTP is configured.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ATFQ Demo <noreply@demo.atfq.org>

# Runtime tuning for a small VM
STARTUP_MAX_RETRIES=120
AUTH_DB_MAX_CONNECTIONS=5
USER_DB_MAX_CONNECTIONS=5
WIKI_DB_MAX_OPEN_CONNS=5
WIKI_DB_MAX_IDLE_CONNS=5
API_GATEWAY_DB_MAX_CONNECTIONS=5
