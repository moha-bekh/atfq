# Vault bootstrap / unseal values generated by services/vault/scripts/setup.sh.
KEY1=
KEY2=
KEY3=
VAULT_TOKEN=

# Net gateway TLS material. Keep escaped newlines as \n if stored on one line.
NET_GATEWAY_SSL_CRT=
NET_GATEWAY_SSL_KEY=

# Shared signing key. Use the same value for AUTH_JWT, API_GATEWAY_JWT and USER_JWT.
AUTH_JWT=
API_GATEWAY_JWT=
USER_JWT=

# Auth service database.
AUTH_DB_URL=postgresql://atfq:atfq@db-auth:5432/atfq_db
AUTH_DB_NAME=atfq_db
AUTH_DB_USER=atfq
AUTH_DB_PASSWORD=
AUTH_SERVER_ADDR=0.0.0.0:8080

# Auth service application secrets.
AUTH_CHA_CHA_KEY=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URL=http://localhost:8080/auth/callback/google
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GITHUB_REDIRECT_URL=http://localhost:8080/auth/callback/github
AUTH_SMTP_USERNAME=
AUTH_SMTP_PASSWORD=

# API gateway secrets.
API_GATEWAY_SERVER_ADDR=0.0.0.0:8080
API_GATEWAY_AUTH_DB_NAME=atfq_db
API_GATEWAY_AUTH_DB_USER=atfq
API_GATEWAY_AUTH_DB_PASSWORD=
API_GATEWAY_USER_DB_NAME=atfq_db
API_GATEWAY_USER_DB_USER=atfq
API_GATEWAY_USER_DB_PASSWORD=

# User service database, JWT and object storage credentials.
USER_DB_NAME=atfq_db
USER_DB_USER=atfq
USER_DB_PASSWORD=
USER_SERVER_ADDR=0.0.0.0:8080
USER_S3_ENDPOINT=http://minio-user:9000
USER_S3_PUBLIC_URL=http://localhost:9000
USER_S3_BUCKET=profiles
USER_AWS_ACCESS_KEY_ID=
USER_AWS_SECRET_ACCESS_KEY=
USER_MINIO_ROOT_USER=
USER_MINIO_ROOT_PASSWORD=

# Wiki service database.
WIKI_DB_NAME=atfq_db
WIKI_DB_USER=atfq
WIKI_DB_PASSWORD=
WIKI_METRICS_ADDR=0.0.0.0:9091
